{
  "name": "housetohomes.net",
  "private": true,
  "scripts": {
    "css:build": "tailwindcss -i ./assets/css/input.css -o ./static/css/output.css --minify",
    "css:watch": "tailwindcss -i ./assets/css/input.css -o ./static/css/output.css --watch",
    "dev": "npm run css:build && hugo server",
    "build": "npm run css:build && hugo --minify"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.3",
    "tailwindcss": "^4.1.3"
  }
}
